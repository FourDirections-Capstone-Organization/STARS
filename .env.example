# ==============================================================================
# STARS Environment Variables Template (.env.example)
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Backend JWT Configuration
JWT_KEY=YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
JwtSettings__SecretKey=YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
JwtSettings__Issuer=STARS.API
JwtSettings__Audience=STARS.Client

# SMTP Email Configuration
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__Username=YOUR_SMTP_EMAIL_ADDRESS
SmtpSettings__Password=YOUR_SMTP_APP_PASSWORD
SmtpSettings__FromEmail=noreply@stars.com
SmtpSettings__FromName=STARS System

# Database & Neo4j Connection Strings
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=stars_backend_db;Username=postgres;Password=postgres
Neo4jSettings__Uri=bolt://localhost:7687
Neo4jSettings__User=neo4j
Neo4jSettings__Password=YOUR_NEO4J_PASSWORD

# Application URLs
AppSettings__FrontendUrl=https://localhost:5173
VITE_API_URL=https://localhost:5100
