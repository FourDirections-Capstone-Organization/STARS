exports[`Performance Evaluation Step 11: Export Bar and Charts > CriterionComparisonChart > matches snapshot for criterion comparison chart structure 1`] = `
<div>
  <div
    class="pe-chart-card "
    data-testid="criterion-comparison-chart-card"
  >
    <div
      class="pe-chart-header"
    >
      <div>
        <h3
          class="pe-chart-title"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chart-column"
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M3 3v16a2 2 0 0 0 2 2h16"
            />
            <path
              d="M18 17V9"
            />
            <path
              d="M13 17V5"
            />
            <path
              d="M8 17v-3"
            />
          </svg>
          <span>
            Criterion Comparison: Self vs. Manager
          </span>
        </h3>
        <p
          class="pe-chart-subtitle"
        >
          Grouped rating alignment per evaluation criterion (1 to 5 scale).
        </p>
      </div>
      <div
        class="pe-chart-employee-selector"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-user pe-selector-icon"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
          />
          <circle
            cx="12"
            cy="7"
            r="4"
          />
        </svg>
        <select
          aria-label="Select Employee for Criterion Comparison"
          class="pe-form-select pe-input-sm"
          data-testid="criterion-chart-employee-select"
        >
          <option
            value="emp-alice"
          >
            Alice Courier
             
            (Courier)
          </option>
          <option
            value="emp-bob"
          >
            Bob Dispatcher
             
            (Courier)
          </option>
        </select>
      </div>
    </div>
    <div
      class="pe-chart-body"
      data-testid="criterion-comparison-body"
    >
      <div
        class="recharts-responsive-container"
        style="width: 100%; height: 320px;"
      >
        <div
          class="recharts-wrapper"
          style="position: relative; cursor: default;"
        />
      </div>
    </div>
  </div>
</div>
`;

